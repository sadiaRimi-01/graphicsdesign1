{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Smart City",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "smartcity.cpp",
                "-o",
                "smartcity.exe",
                "-I",
                "C:\\msys64\\mingw64\\include",
                "C:\\msys64\\mingw64\\lib\\libbgi.a",
                "-lgdi32",
                "-lcomdlg32",
                "-luuid",
                "-loleaut32",
                "-lole32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}